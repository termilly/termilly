<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The .NET analyzers' recommended rules, and the code style in .editorconfig, are checked on every build. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The version setup installs and Apps & features shows (installer/build.ps1 reads it from Termilly.exe). -->
    <Version>1.0.0</Version>
    <Company>Termilly</Company>
    <Product>Termilly</Product>
  </PropertyGroup>
</Project>
