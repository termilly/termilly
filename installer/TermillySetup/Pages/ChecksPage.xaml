<UserControl x:Class="Termilly.Setup.Pages.ChecksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,24,18">
            <TextBlock x:Name="Heading" Style="{StaticResource H1}" Text="Ready to install" Margin="0,0,0,14" />
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Raised}">
                <StackPanel x:Name="Items" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
