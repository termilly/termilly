<UserControl x:Class="Termilly.Setup.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,24,18">
            <TextBlock Style="{StaticResource H1}" Text="Options" Margin="0,0,0,12" />

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <Border Style="{StaticResource SegBox}" DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="JustMe" Style="{StaticResource Seg}" GroupName="Scope" Content="Just me" />
                            <RadioButton x:Name="AllUsers" Style="{StaticResource Seg}" GroupName="Scope" Content="All users" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Name}" Text="Install for" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <Button x:Name="Browse" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Browse" />
                    <TextBox x:Name="Dir" Style="{StaticResource Field}" AutomationProperties.Name="Install folder" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <CheckBox x:Name="StartMenu" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Start menu shortcut" />
                    <TextBlock Style="{StaticResource Name}" Text="Start menu shortcut" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <CheckBox x:Name="Desktop" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Desktop shortcut" />
                    <TextBlock Style="{StaticResource Name}" Text="Desktop shortcut" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <CheckBox x:Name="Explorer" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Open in Termilly in Explorer" />
                    <TextBlock Style="{StaticResource Name}" Text="&quot;Open in Termilly&quot; in Explorer" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <CheckBox x:Name="PathCommand" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="termilly command on PATH" />
                    <TextBlock Style="{StaticResource Name}" Text="termilly command in cmd and PowerShell" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <CheckBox x:Name="Agent" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Claude Code integration" />
                    <TextBlock Style="{StaticResource Name}" Text="Claude Code integration" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <CheckBox x:Name="SignIn" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Keep shells running at sign-in" />
                    <TextBlock Style="{StaticResource Name}" Text="Keep shells running at sign-in" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" BorderThickness="0">
                <DockPanel>
                    <Border Style="{StaticResource SegBox}" DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Download" Style="{StaticResource Seg}" GroupName="Prereq" Content="Download" />
                            <RadioButton x:Name="Included" Style="{StaticResource Seg}" GroupName="Prereq" Content="Included" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Name}" Text=".NET and WebView2, if missing" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TextBlock x:Name="Space" Style="{StaticResource Fine}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
