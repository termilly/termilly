<UserControl x:Class="Termilly.Setup.Pages.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,24,28,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="License" Margin="0,0,0,14" />
        </StackPanel>
        <CheckBox x:Name="Accept" DockPanel.Dock="Bottom" Style="{StaticResource Check}" Margin="0,14,0,0" Content="I accept the license terms" />
        <Border Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12" Focusable="True">
                <TextBlock x:Name="Text" Style="{StaticResource Mono}" Foreground="{DynamicResource TermText}" TextWrapping="Wrap" LineHeight="18" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
