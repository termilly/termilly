<UserControl x:Class="Termilly.Setup.Pages.MaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Background="{DynamicResource Raised}" Padding="14,16">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentFill}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,24,28,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Image Source="{StaticResource Mark}" Width="44" Height="44" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Style="{StaticResource H1}" Margin="0" />
                <TextBlock x:Name="Sub" Style="{StaticResource Desc}" FontSize="13" />
            </StackPanel>
        </DockPanel>
        <UniformGrid Columns="2" VerticalAlignment="Top" Margin="-5,0">
            <Button x:Name="UpdateCard" Style="{StaticResource Card}" AutomationProperties.Name="{Binding Text, ElementName=UpdateTitle}">
                <StackPanel>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentFill}" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Path x:Name="UpdateIcon" Data="M8,2.5 V10.5 M4.5,7 L8,10.5 L11.5,7 M3,13.5 H13" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Width="16" Height="16"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock x:Name="UpdateTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextStrong}" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Desc}" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="UninstallCard" Style="{StaticResource Card}" AutomationProperties.Name="Uninstall">
                <StackPanel>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource DangerFill}" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Path Data="M3,4.5 H13 M6.5,4.5 V3 H9.5 V4.5 M4.5,4.5 L5.2,13 H10.8 L11.5,4.5" Stroke="{DynamicResource DangerText}" StrokeThickness="1.5" Width="16" Height="16"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock Text="Uninstall" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextStrong}" />
                    <TextBlock Style="{StaticResource Desc}" Margin="0,6,0,0" Text="Removes Termilly from this PC." />
                </StackPanel>
            </Button>
        </UniformGrid>
    </DockPanel>
</UserControl>
