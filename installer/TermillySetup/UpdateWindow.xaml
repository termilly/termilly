<Window x:Class="Termilly.Setup.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Termilly Update" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Padding="30">
        <StackPanel>
            <Image Source="{StaticResource Mark}" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,20" />
            <TextBlock x:Name="Status" Text="Updating Termilly" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,22,0,4" />
            <TextBlock x:Name="Reason" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="LogLabel" Text="Setup log" Foreground="{DynamicResource Muted}" Margin="0,18,0,5" Visibility="Collapsed" />
            <TextBox x:Name="LogPath" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" />
            <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="18,7" Visibility="Collapsed" Click="OnClose" />
        </StackPanel>
    </Border>
</Window>
