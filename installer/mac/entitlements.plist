<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What Termilly's programs need under the hardened runtime (build-app.sh signs every program in the app with it).
  .NET compiles code as it runs, so it needs to write and run memory pages (allow-jit, and
  allow-unsigned-executable-memory for the runtime's own stubs).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
