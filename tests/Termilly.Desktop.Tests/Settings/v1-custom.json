  "aiModel": "qwen",
  "aiEndpoint": "http://127.0.0.1:1234/v1",
  "aiReadOutput": "always",
  "aiReadHistory": "never",
  "aiRunCommands": "always",
  "disabledPlugins": [ "acme.solarized" ],
