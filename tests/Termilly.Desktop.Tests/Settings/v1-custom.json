  "forwards": [ { "id": "f1", "name": "pg", "target": "conn-c1", "kind": "L", "listenPort": 5433, "destHost": "localhost", "destPort": 5432, "autoStart": true } ],
  "backgroundShells": true,
  "backgroundAtSignIn": true,
  "agentLimit": 4,
  "dynamicSources": false,
  "serialPorts": [ { "port": "COM5", "baud": 9600, "dataBits": 8, "parity": "even", "stopBits": "1", "flow": "rts/cts", "lineEnding": "CRLF", "log": true } ],
  "networkConsoles": [ { "id": "n1", "name": "switch-a", "host": "10.0.0.20", "port": 2001, "protocol": "telnet", "lineEnding": "CR", "log": false } ],
