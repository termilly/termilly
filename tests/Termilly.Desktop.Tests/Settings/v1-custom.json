  "prodTint": true,
  "logFolder": "D:\\logs",
  "logFormat": "raw",
  "logTimestamps": true,
  "logRedact": false,
  "logKeepDays": 30,
  "logTags": [ "prod" ],
  "logProfiles": [ "ssh-db" ],
