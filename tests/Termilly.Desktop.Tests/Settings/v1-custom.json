{
  "fontFamily": "Cascadia Mono",
  "fontSize": 16,
  "theme": "nord",
  "cursorStyle": "block",
  "cursorBlink": false,
  "lineHeight": 1.4,
  "scrollback": 20000,
  "defaultProfile": "pwsh",
  "saveOutput": false,
  "historyDays": 90,
  "redactSecrets": true,
  "confirmCloseWorkspace": false,
  "profiles": [
    { "id": "custom-1", "name": "API", "commandLine": "npm run dev", "workingDirectory": "C:\\dev\\api", "environment": { "NODE_ENV": "dev" }, "tags": [ "dev" ], "icon": "bash" }
  ],
  "uiFontFamily": "Segoe UI Variable",
  "textSmoothing": "cleartype",
  "showActivity": false,
  "agentIntegration": false,
  "shellIntegration": false,
  "globalJumpHotkey": true,
  "notifyNeedsInput": false,
  "notifyError": false,
  "notifyDone": false,
  "quake": true,
