  "costDisplay": "tokens",
  "gitStatus": false,
  "agentReadDefault": false,
  "sshKeepAlive": false,
  "sshReconnect": false,
  "sshAttach": { "ssh-db": "main" },
  "remoteSetup": { "ssh-db": "installed" },
  "recordFolder": "D:\\casts",
  "recordRedact": false,
  "recordAgents": true,
  "recordMaxMb": 250,
  "terminalPorts": false,
  "costLedger": { "2026-10-17": { "total": 1.25, "ws": { "api": 1.25 } } },
