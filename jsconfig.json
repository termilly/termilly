{
  // TypeScript's checker over the plain JavaScript (no build step), in strict mode: every file, typed through JSDoc
  // and the global types in src/Termilly.Desktop/types. Each file also says // @ts-check, for editors without this.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/Termilly.Desktop/wwwroot/js/**/*.js", "src/Termilly.Desktop/types/*.d.ts"]
}
