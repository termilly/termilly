<Project Sdk="Microsoft.NET.Sdk">

  <!-- Termilly on Linux: a Photino window (WebKitGTK) around the same web UI, sharing the Windows app's
       platform-neutral code (compiled in from src/Termilly.Desktop) with Linux versions of the rest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>termilly</AssemblyName>
    <RootNamespace>Termilly.Linux</RootNamespace>
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Termilly.Pty\Termilly.Pty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Termilly.Core.Tests" />
  </ItemGroup>

  <!-- The Windows app's code, without its window (WPF) and the parts only Windows has. -->
  <ItemGroup>
    <Compile Include="..\Termilly.Desktop\**\*.cs" Exclude="..\Termilly.Desktop\bin\**;..\Termilly.Desktop\obj\**;..\Termilly.Desktop\App.xaml.cs;..\Termilly.Desktop\AssemblyInfo.cs;..\Termilly.Desktop\MainWindow.xaml.cs;..\Termilly.Desktop\WindowPlacement.cs;..\Termilly.Desktop\WindowInterop.cs;..\Termilly.Desktop\QuakeMode.cs;..\Termilly.Desktop\GlobalHotkeys.cs;..\Termilly.Desktop\Notifications.cs;..\Termilly.Desktop\Ports.cs;..\Termilly.Desktop\WindowsPlatform.cs;..\Termilly.Desktop\WindowsFonts.cs;..\Termilly.Desktop\StartupLoader.cs;..\Termilly.Desktop\TaskbarBadge.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- The page, served from next to the app, with the start-up loader's logo (drawn by the window on Windows). -->
  <ItemGroup>
    <Content Include="..\Termilly.Desktop\wwwroot\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Termilly.Desktop\Assets\loader\*.png" LinkBase="wwwroot\assets\loader" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The app icon, at the sizes desktops look for (hicolor theme layout; install-desktop.sh installs it). -->
  <ItemGroup>
    <None Include="icons\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="termilly.desktop;install-desktop.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE;..\..\NOTICE;..\..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The background host (termilly-host) goes in host/: it keeps shells running while the window is closed. -->
  <ItemGroup>
    <ProjectReference Include="..\Termilly.Host\Termilly.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyHost" AfterTargets="Build">
    <MSBuild Projects="..\Termilly.Host\Termilly.Host.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="HostTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <HostOutputDir>$([System.IO.Path]::GetDirectoryName($(HostTargetPath)))/</HostOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <HostFiles Include="$(HostOutputDir)**/*" Exclude="$(HostOutputDir)**/*.pdb;$(HostOutputDir)conpty/**" />
    </ItemGroup>
    <Copy SourceFiles="@(HostFiles)" DestinationFiles="@(HostFiles->'$(OutDir)host/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Exec Command="chmod +x &quot;$(OutDir)host/termilly-host&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <!-- dotnet publish (installer/linux/build-deb.sh): the agent helper and the host go along, as the build has them. -->
  <Target Name="PublishAgentAndHost" AfterTargets="Publish">
    <ItemGroup>
      <ShippedAgent Include="$(OutDir)agent/**" />
      <ShippedHost Include="$(OutDir)host/**" />
    </ItemGroup>
    <Copy SourceFiles="@(ShippedAgent)" DestinationFiles="@(ShippedAgent->'$(PublishDir)agent/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ShippedHost)" DestinationFiles="@(ShippedHost->'$(PublishDir)host/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!--
    An executable can't carry its own icon on Linux; the file manager (Nautilus, Nemo) shows a per-file custom icon
    instead, kept in GIO's metadata. Set it on the built termilly; skipped where gio isn't installed.
  -->
  <Target Name="SetFileIcon" AfterTargets="Build" Condition="Exists('/usr/bin/gio')">
    <PropertyGroup>
      <FullOutDir>$([System.IO.Path]::GetFullPath('$(OutDir)'))</FullOutDir>
    </PropertyGroup>
    <Exec Command="gio set &quot;$(FullOutDir)termilly&quot; metadata::custom-icon &quot;file://$(FullOutDir)icons/hicolor/256x256/apps/termilly.png&quot;" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

  <!-- Shell integration scripts (PowerShell's termilly.ps1), next to the app as on Windows. -->
  <ItemGroup>
    <None Include="..\Termilly.Desktop\shell\**\*" LinkBase="shell" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The agent helper goes in agent/ next to the app, as on Windows, under four names that all run termilly-hook.dll:
    termilly-hook for Claude Code's hooks, claude (the shim terminals find first on PATH, see AgentHooks), termilly
    (the termilly command and MCP server) and termilly-askpass (ssh's SSH_ASKPASS).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Termilly.Agent\Termilly.Agent.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyAgentHelper" AfterTargets="Build">
    <MSBuild Projects="..\Termilly.Agent\Termilly.Agent.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="AgentTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <AgentOutputDir>$([System.IO.Path]::GetDirectoryName($(AgentTargetPath)))/</AgentOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <AgentFiles Include="$(AgentOutputDir)termilly-hook*" Exclude="$(AgentOutputDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentFiles)" DestinationFolder="$(OutDir)agent" SkipUnchangedFiles="true" />
    <!-- The extensionless apphost and chmod are Linux-only (on Windows this project is built just for the tests). -->
    <Copy SourceFiles="$(AgentOutputDir)termilly-hook" DestinationFiles="$(OutDir)agent/claude" SkipUnchangedFiles="true" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Copy SourceFiles="$(AgentOutputDir)termilly-hook" DestinationFiles="$(OutDir)agent/termilly" SkipUnchangedFiles="true" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Copy SourceFiles="$(AgentOutputDir)termilly-hook" DestinationFiles="$(OutDir)agent/termilly-askpass" SkipUnchangedFiles="true" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command="chmod +x &quot;$(OutDir)agent/termilly-hook&quot; &quot;$(OutDir)agent/claude&quot; &quot;$(OutDir)agent/termilly&quot; &quot;$(OutDir)agent/termilly-askpass&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <!-- Names on the wire and in the environment shared with the agent helper (src/Shared): one place for each. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <Using Include="Termilly.Shared" />
  </ItemGroup>

</Project>
