<Window x:Class="Termilly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Termilly" Height="720" Width="1180" MinWidth="702" MinHeight="402"
        WindowStartupLocation="Manual" Background="#000000"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <!-- No native caption or control box: the page draws its own title bar and window controls.
         Caption drag and edge resize are forwarded from the page (see WindowInterop), because the
         WebView covers the whole client area. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame" BorderBrush="#262626" BorderThickness="1">
        <Grid>
            <!-- The page, sized to the window in code. Until it says it's ready it waits far outside the window, where
                 it can't cover the start-up screen: a hidden WebView isn't laid out at all, and this way its terminals
                 start at their real size and nothing reflows when it moves in. A Canvas, because it doesn't hold its
                 children to its own size. -->
            <Canvas x:Name="Stage">
                <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#000000" Canvas.Left="-30000" Canvas.Top="-30000" />
            </Canvas>

            <!-- Start-up screen, on the theme's background with no frame: the mark, and under it "Loading..." typed
                 with a violet caret (as js/loader.js does on Linux) until the page is ready. Colours and the typing are
                 set in code. Drag it to move the window. -->
            <Grid x:Name="Loader" Background="#000000">
                <StackPanel x:Name="LoaderBox" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Source is set in code: the pre-rendered image whose pixel size matches this display. -->
                    <Image x:Name="LoaderMark" Width="48" Height="48" Stretch="Fill" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <!-- As wide as "Loading..." and its caret (the hidden copy) and centred under the mark: the full line
                         sits centred, and while it's typed the letters grow from the same place instead of jumping. -->
                    <Grid HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="Hidden">
                            <TextBlock Text="Loading..." FontFamily="Segoe UI" FontSize="15" TextOptions.TextFormattingMode="Display" />
                            <Rectangle Width="2" Margin="2,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LoaderText" FontFamily="Segoe UI" FontSize="15" Foreground="#E6E6E6" VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                            <Rectangle x:Name="LoaderCaret" Width="2" Height="17" Margin="2,0,0,0" Fill="#8B7BFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
