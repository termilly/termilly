<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Termilly</AssemblyName>
    <RootNamespace>Termilly.Desktop</RootNamespace>
    <!-- Generated by branding/make-icon.ps1. -->
    <ApplicationIcon>Assets\termilly.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The loader's logo, pre-rendered at 64 px for each display scale (100% to 200%). -->
    <Resource Include="Assets\loader\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Termilly.Pty\Termilly.Pty.csproj" />
    <InternalsVisibleTo Include="Termilly.Desktop.Tests" />
  </ItemGroup>

  <!--
    The agent helper goes in agent\ next to the app, twice: termilly-hook.exe for Claude Code's hooks, and the same
    program as claude.exe, the shim terminals find first on PATH (see AgentHooks). Both run termilly-hook.dll.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Termilly.Agent\Termilly.Agent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The background host (termilly-host.exe, with its own copy of the bundled ConPTY) goes in host\. -->
  <ItemGroup>
    <ProjectReference Include="..\Termilly.Host\Termilly.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyHost" AfterTargets="Build">
    <MSBuild Projects="..\Termilly.Host\Termilly.Host.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="HostTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <HostOutputDir>$([System.IO.Path]::GetDirectoryName($(HostTargetPath)))\</HostOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <HostFiles Include="$(HostOutputDir)**\*" Exclude="$(HostOutputDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(HostFiles)" DestinationFiles="@(HostFiles->'$(OutDir)host\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAgentHelper" AfterTargets="Build">
    <MSBuild Projects="..\Termilly.Agent\Termilly.Agent.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="AgentTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <AgentOutputDir>$([System.IO.Path]::GetDirectoryName($(AgentTargetPath)))\</AgentOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <AgentFiles Include="$(AgentOutputDir)termilly-hook.*" Exclude="$(AgentOutputDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentFiles)" DestinationFolder="$(OutDir)agent" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(AgentOutputDir)termilly-hook.exe" DestinationFiles="$(OutDir)agent\claude.exe" SkipUnchangedFiles="true" />
    <!-- And as termilly.exe: the termilly command (API and MCP server) for scripts and agents. -->
    <Copy SourceFiles="$(AgentOutputDir)termilly-hook.exe" DestinationFiles="$(OutDir)agent\termilly.exe" SkipUnchangedFiles="true" />
    <!-- And as termilly-askpass.exe: ssh's SSH_ASKPASS for SSH connections whose password is a reference. -->
    <Copy SourceFiles="$(AgentOutputDir)termilly-hook.exe" DestinationFiles="$(OutDir)agent\termilly-askpass.exe" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <!-- Workspace layout files (.termilly.yml); see WorkspaceLayout. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shell integration scripts terminals load (see SessionProfiles.WithShellIntegration). -->
    <None Include="shell\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Loaded at run time for window icons at exactly the taskbar's size (see WindowInterop). -->
    <None Include="Assets\termilly.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The license, the notice and the third-party notices go next to the app, as Apache-2.0 and the components ask. -->
    <None Include="..\..\LICENSE;..\..\NOTICE;..\..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The icon Windows shows on Termilly's notifications (see Notifications.Register). -->
    <None Include="Assets\loader\mark-128.png" Link="Assets\toast.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Names on the wire and in the environment shared with the agent helper (src/Shared): one place for each. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <Using Include="Termilly.Shared" />
  </ItemGroup>

</Project>
