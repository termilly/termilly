<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The small helper coding agents talk to Termilly through. Copied into agent\ next to the app twice: as
    termilly-hook.exe (what Claude Code's hooks run) and as claude.exe (the shim terminals find first on PATH,
    which starts the real Claude Code with Termilly's hooks added). See Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>termilly-hook</AssemblyName>
    <RootNamespace>Termilly.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Release: precompiled (ReadyToRun), as the apps publish it (CopyAgentHelper in Termilly.Desktop and Termilly.Linux,
    installer/mac/build-app.sh). It runs for every hook and every agent start, so its own start counts. The systems
    it's built for are restored up front, as a publish for one needs.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- The Linux keyring and the macOS keychain, shared with the app: askpass reads saved passwords from them. -->
  <ItemGroup>
    <Compile Include="..\Termilly.App\LibSecret.cs" Link="LibSecret.cs" />
    <Compile Include="..\Termilly.App\MacKeychain.cs" Link="MacKeychain.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Termilly.Desktop.Tests" />
    <InternalsVisibleTo Include="Termilly.Core.Tests" />
  </ItemGroup>

  <!-- Names on the wire and in the environment shared with the app (src/Shared): one place for each. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <Using Include="Termilly.Shared" />
  </ItemGroup>

</Project>
