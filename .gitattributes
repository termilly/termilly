# Shell scripts and server configs run on Linux: always LF.
*.sh   text eol=lf
*.conf text eol=lf
*.zsh  text eol=lf
src/Termilly.Desktop/shell/zsh/.z* text eol=lf
src/Termilly.Desktop/shell/tcsh/.tcshrc text eol=lf
*.tcsh text eol=lf
*.ksh  text eol=lf
# Batch files need CRLF: cmd.exe misreads some lines with LF only.
*.cmd  text eol=crlf
